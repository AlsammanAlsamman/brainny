    {
      "kind": "skill",
      "title": "ETL retry-with-backoff pattern",
      "summary": "Wrap each pipeline stage in exponential backoff with jitter so a transient failure doesn't cascade into a full pipeline restart.",
      "detail": null,
      "domain": "data-pipeline",
      "tags": [
        "etl",
        "reliability"
      ],
      "trigger": null,
      "origin": "human",
      "attachments": [
        {
          "type": "code",
          "filename": "backoff.py",
          "description": "retry-with-backoff implementation"
        }
      ],
      "snippet": "def with_backoff(fn, max_tries=5, base=0.5):\n    for attempt in range(max_tries):\n        try:\n            return fn()\n        except TransientError:\n            time.sleep(base * (2 ** attempt) + random.uniform(0, 0.3))\n    raise",
      "id": "idea_0004",
      "state": "seed",
      "provenance": [
        {
          "project": "brainny-demo",
          "session": "example-build",
          "ts": "2026-09-10T22:09:42+00:00"
        }
      ],
